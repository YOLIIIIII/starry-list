{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starry List",
  "version": "1.0.0",
  "identifier": "app.starrylist.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "星轨日历 · Starry List",
        "width": 980,
        "height": 680,
        "minWidth": 380,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "publisher": "yoli",
    "copyright": "Copyright (c) 2026 yoli",
    "useLocalToolsDir": true,
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "星轨日历：离线日历与待办清单",
    "windows": {
      "bundleVCRuntime": true,
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}

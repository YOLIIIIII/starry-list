{
  "productName": "SL006 Isolated Research",
  "version": "0.1.0",
  "identifier": "app.starrylist.research.sl006",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "probe",
        "title": "SL006 Probe",
        "width": 500,
        "height": 360,
        "x": 40,
        "y": 60,
